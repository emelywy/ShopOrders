<Project>
  <!-- Спільні налаштування всіх проєктів рішення ShopOrders. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Діана Андрощук</Authors>
    <Product>ShopOrders</Product>
    <!--
      Обґрунтування придушених правил:
      SA1623 - вимагає англійського початку "Gets ..." в описі властивості, а документація
               проєкту ведеться українською;
      SA1642 - вимагає англійського шаблону "Initializes a new instance" в описі конструктора;
      CA1305 - інтерполяція в повідомленнях журналу й винятків; гроші й дати у файлах
               і на екрані форматуються явно з CultureInfo.InvariantCulture.
    -->
    <NoWarn>$(NoWarn);SA1623;SA1642;CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
